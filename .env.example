# Original defaults: 小小与程渝
REALITY_TRAVEL_DEFAULT_TRAVELER_ID=chengyu
REALITY_TRAVEL_TRAVELER_NAME=程渝
REALITY_TRAVEL_COMPANION_NAME=小小

# HTTP service
REALITY_TRAVEL_HOST=127.0.0.1
REALITY_TRAVEL_PORT=3023
REALITY_TRAVEL_PUBLIC_BASE_URL=http://127.0.0.1:3023
REALITY_TRAVEL_STREET_CACHE_SECONDS=3600

# Optional Google Street View Static API key. Weather and geocoding work without it.
GOOGLE_STREET_VIEW_API_KEY=

# Optional postcard image generator module. Leave blank to keep postcards text-only.
# The async function must accept: (prompt, output_dir, filename_prefix="postcard")
REALITY_TRAVEL_IMAGE_GENERATOR_MODULE=
REALITY_TRAVEL_IMAGE_GENERATOR_FUNCTION=generate_codex_image
REALITY_TRAVEL_IMAGE_GENERATOR_PROVIDER=external_module

# Optional runtime storage overrides. Relative paths are resolved from the launch directory.
# REALITY_TRAVEL_DATA_DIR=data
# REALITY_TRAVEL_CACHE_DIR=cache
